# Все адреса ClickHouse должны быть доступны ИЗ контейнеров.
# Для БД на Windows-хосте: host.docker.internal; для удалённой БД: DNS/IP.
CLICKHOUSE_HOST=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=telemetry
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true
# Grafana отдельный обратный флаг TLS-проверки; обычно false.
GRAFANA_CLICKHOUSE_TLS_SKIP_VERIFY=false
CLICKHOUSE_CONNECT_TIMEOUT=5
CLICKHOUSE_QUERY_TIMEOUT=30
# DateTime без timezone трактуется в зоне сервера БД; уточните её у администратора.
CLICKHOUSE_TIMEZONE=UTC

ADMIN_PORT=5173
API_PORT=8000
GRAFANA_PORT=3000
SUPERSET_PORT=8088
ADMIN_ORIGIN=http://localhost:5173
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_INTERNAL_URL=http://superset:8088
TELEMETRY_INTERNAL_URL=http://telemetry-api:8000
GRAFANA_PUBLIC_URL=http://localhost:3000
# Полные browser URL: http://localhost:3000/d/UID/slug?orgId=1&kiosk
GRAFANA_INFINITY_DASHBOARD_URL=
GRAFANA_DIRECT_DASHBOARD_URL=
# UUID из меню Embed dashboard, НЕ числовой dashboard ID.
SUPERSET_EMBEDDED_DASHBOARD_ID=

# Заполните случайными строками до запуска. Не меняйте после создания metadata DB.
SUPERSET_SECRET_KEY=
SUPERSET_GUEST_TOKEN_SECRET=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@localhost.invalid
SUPERSET_TECH_USER=embed_service
SUPERSET_TECH_PASSWORD=
SUPERSET_GUEST_TOKEN_TTL=300
SUPERSET_API_TIMEOUT=30
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS_ENABLED=true

API_DEFAULT_ROWS=1000
# До 100000 исключительно для тестирования.
API_MAX_ROWS=10000
API_MAX_RANGE_DAYS=180

# Необязательные browser runner URL. Если пусто, берутся localhost + API_PORT/ADMIN_PORT.
BENCHMARK_API_URL=
BENCHMARK_ADMIN_URL=
